# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Panoptes CPU serving image — evaluation, edge boxes, and CI.
#
# Build from the REPO ROOT:
#
#   docker build -f deploy/docker/Dockerfile.cpu -t panoptes:0.1.0-cpu .
#
# Extras: [onnx,alpr,postgres] — ONNX Runtime CPU detector, the MIT ALPR
# stack, and asyncpg so the compose stack's Postgres DSN works out of the box.
# For GPU inference use deploy/docker/Dockerfile.gpu instead.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- builder --
FROM python:3.12-slim-trixie AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

RUN uv venv /opt/venv

WORKDIR /build
# The dashboard ships inside the wheel (src/panoptes/dashboard) — no separate
# COPY needed.
COPY pyproject.toml README.md ./
COPY src ./src

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install ".[onnx,alpr,postgres]"

# --- AGPL toggle ------------------------------------------------------------
# ultralytics/YOLO26 is AGPL-3.0 (network clause applies to hosted use).
# Enable only with an Ultralytics Enterprise License or full AGPL compliance;
# deploy/scripts/license_gate.py flags it unless run with --allow-agpl.
# RUN --mount=type=cache,target=/root/.cache/uv \
#     uv pip install ".[yolo]"
# ----------------------------------------------------------------------------

# ---------------------------------------------------------------- runtime --
FROM python:3.12-slim-trixie

# libglib2.0: opencv-python-headless; libgomp1: onnxruntime; curl: HEALTHCHECK.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl libglib2.0-0t64 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home --shell /usr/sbin/nologin panoptes \
    && mkdir -p /app/data /etc/panoptes \
    && chown -R panoptes:panoptes /app

COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

WORKDIR /app
USER panoptes
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/api/v1/system/health || exit 1

# Mount your config at /etc/panoptes (see deploy/docker-compose.yml).
ENTRYPOINT ["panoptes", "serve", "-c", "/etc/panoptes/panoptes.yaml"]
